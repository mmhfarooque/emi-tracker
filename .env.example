# Defaults work for local development. Copy to .env only to override them.
APP_HOST=127.0.0.1
PORT=3100
DATABASE_PATH=data/emi.sqlite
COOKIE_SECURE=false
TRUST_PROXY=0
ALLOW_REGISTRATION=true
# Change if another local Vite instance already uses this port.
HMR_PORT=24679

# Google OAuth: create a Web application client in Google Cloud.
# Keep the secret in .env; never commit it or put it in a VITE_ variable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3100/api/auth/google/callback
